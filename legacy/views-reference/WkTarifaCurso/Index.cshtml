@{
	ViewData["Title"] = "Tarifa de Cursos";
	Layout = "~/Views/Shared/_Layout_Workflow.cshtml";
	var organizaciones = (IEnumerable<KeyValuePair<string, string>>)ViewBag.Organizaciones;
}
<link href="~/css/workflow/typeahead.css" rel="stylesheet" />
<style>
	.custom-switch {
		transform: scale(1.8);
	}
</style>
<div id="div-content">
	<div class="row">
		<div class="col-md-10">
			<h3 class="fw-bold">
				Registro de Tarifas de Curso
			</h3>
		</div>
	</div>
	<div class="row">
		<div class="col-md-3 mt-2">
			<button class="btn btn-outline-secondary form-control text-start btn-show active" id="btn-ndividual" data-show="div-container-individual">
				<span class="fas fa-solid fa-file fs-5 mt-2"></span>
				<p class="mt-2 mb-0">Registro individual</p>
			</button>
		</div>
		<div class="col-md-3 mt-2">
			<button class="btn btn-outline-secondary form-control text-start btn-show" id="btn-asivo" data-show="div-container-masivo">
				<span class="fas fa-solid fa-folder fs-5 mt-2"></span>
				<p class="mt-2 mb-0">Registro masivo</p>
			</button>
		</div>
		<div class="col-md-3 mt-2">
			<button class="btn btn-outline-secondary form-control text-start btn-show" id="btn-copiar" data-show="div-container-copiado">
				<span class="fas fa-solid fa-copy fs-5 mt-2"></span>
				<p class="mt-2 mb-0">Copiar de periodo anterior</p>
			</button>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col-sm-12 col-md-5">
			<div class="fw-bold">
				Ingresa la información solicitada
			</div>
		</div>
	</div>

	<div id="div-container-individual" class="tarifa-container">
		<div class="row">
			<div class="col-md-6 mt-4">
				<div class="form-floating">
					<select class="form-select" id="sel-organizacion-individual" data-val="true" placeholder="" required>
						@foreach (var organizacion in organizaciones?.ToList())
						{
							<option value="@organizacion.Key">@organizacion.Value</option>
						}
					</select>
					<label for="organizacion">Organizaci&oacute;n</label>
				</div>
			</div>
			<div class="col-md-6 mt-4">
				<div class="form-floating">
					<select class="form-select" id="sel-periodo-individual" data-val="true" placeholder="" required>
					</select>
					<label for="periodo">Periodo</label>
				</div>
			</div>
			<div class="col-md-6 mt-4">
				<div class="form-floating">
					<input type="text" id="input-tarifa-individual" class="form-control" data-val="true" placeholder="" required>
					<label for="tarifa">Tarifa</label>
				</div>
			</div>
			<div class="col-md-6 mt-4 d-none" id="div-tipo-sesion-individual">
				<div class="form-floating">
					<select class="form-select" id="sel-tipo-sesion-individual" data-val="true" placeholder="">
						<option value="Síncrono">Síncrono</option>
						<option value="Asíncrono">Asíncrono</option>
						<option value="Ambos">Ambos</option>
					</select>
					<label for="tipo-sesion">Tipo de sesión</label>
				</div>
			</div>
			<div class="col-md-6 mt-4">
				<div class="input-group input-group-typeahead-icon">
					<span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
					<input type="text" id="input-curso-individual" class="form-control" placeholder="Código o nombre de curso">
				</div>
				@* <div class="form-floating">
			                 <select class="form-select" id="sel-curso-individual" data-val="true" placeholder="" required>
			                 </select>
			                 <label for="curso" style="top:-5px;">Curso</label>
			             </div> *@
			</div>
			<div class="col-md-6 mt-4">
				<button type="button" class="btn btn-primary form-control" id="btn-agregar-individual">Agregar</button>
			</div>
		</div>
	</div>

	<div id="div-container-masivo" class="tarifa-container d-none">
		<div class="row mt-2">
			<form autocomplete="off" id="frmUpload">
			<div class="col-md-12">
				<div class="card">
					<div class="card-body bg-light">
						<div class="row">
							<div class="col-md-1">
								<button class="btn bg-white"><span class="fas fa-upload"></span></button>
							</div>
							<div class="col-md-6">
								<p class="fw-bold m-0 p-0" id="file-masivo-filename">Subir un excel</p>
								<span class="text-muted">M&aacute;ximo 10MB por archivo - Formatos .xlsx</span>
							</div>
							<div class="col-md-2">
								<button type="button" class="btn btn-primary form-control" id="btn-subir-masivo">Subir&nbsp;<span class="fas fa-upload"></span></button>
							</div>
							<div class="col-md-3">
								<a class="btn btn-primary form-control" id="btn-descarga-formato" target="_blank"><i class="fas fa-download"></i> Descargar Formato</a>
							</div>
						</div>
					</div>
				</div>
				<input type="file" class="form-control d-none" id="file-masivo" accept=".xlsx">
			</div>
			</form>
		</div>
		<div class="row mt-2">
			<div class="col-md-12">
				<div class="alert alert-warning alert-dismissible fade show d-none" role="alert" id="div-alert-masivo">
				</div>
			</div>
		</div>
	</div>

	<div id="div-container-copiado" class="tarifa-container d-none">
		<div class="row mt-2">
			<div class="col-md-3 mt-3">
				<div class="form-floating">
					<select class="form-select" id="sel-organizacion-copiado">
						@foreach (var organizacion in organizaciones?.ToList())
						{
							<option value="@organizacion.Key">@organizacion.Value</option>
						}
					</select>
					<label for="copiado-organizacion">Organizaci&oacute;n</label>
				</div>
			</div>
			<div class="col-md-3 mt-3">
				<div class="form-floating">
					<select class="form-select" id="sel-periodo-copiado">
					</select>
					<label for="sel-periodo-copiado">Periodo</label>
				</div>
			</div>
			<div class="col-md-3 mt-3">
				<button class="btn btn-primary form-control" id="btn-copiar-copiado">Copiar</button>
			</div>
		</div>
	</div>

	<div class="row mt-2">
		<div class="col-md-12 mt-4">
			<div class="form-floating">
				<textarea class="form-control" id="txt-comentario" rows="4" placeholder></textarea>
				<label for="txt-comentario">Comentarios de solicitud</label>
			</div>
		</div>
	</div>
	<div class="card card-index mt-4 card-worklow">
		<div class="card-body">
			<div>
				<div class="table-responsive table-responsive-workflow">
					<table id="tbl-tarifas" class="table table-workflow text-nowrap" style="width:100%;">
					</table>
				</div>
			</div>
		</div>
	</div>
	<div id="div-table-cards" class="table-cards">
		<div id="div-content-cards">
		</div>
		<div class="dataTables_paginate paging_simple_numbers">
			<ul class="pagination" id="paginationCard">
				<!-- Links de paginación se generarán aquí -->
			</ul>
		</div>
	</div>
	<div class="div-copiar d-none">
		<div class="row mt-4 ">
			<div class="col-sm-12 col-md-5">
				<div class="fw-bold">
					Cursos que no tienen asignación en el periodo actual
				</div>
			</div>
			<div class="col-sm-12 col-md-4">
				<div class="form-check form-switch">
					<input class="form-check-input custom-switch" type="checkbox" role="switch" id="btnPeriodoAnt"><label class="form-check-label" for="btnPeriodoAnt"></label>
				</div>
			</div>
		</div>
		<div class="card card-index mt-3 card-worklow d-none" id="cursoPeriodoAnterior">
			<div class="card-body">
				<div>
					<div class="table-responsive table-responsive-workflow">
						<table id="cursoAnteriorTable" class="table text-nowrap table-workflow" style="width:100%;">
						</table>
					</div>
					<div id="wkTarifaCursoAnteriorCard" class="table-cards">
						<div id="contentCards-tarifaCursoAnterior">
						</div>
						<div class="dataTables_paginate paging_simple_numbers">
							<ul class="pagination" id="paginationCard">
								<!-- Links de paginación se generarán aquí -->
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="row mt-4">
		<div class="col-md-4 offset-md-4">
			<button class="btn btn-primary form-control" id="btn-registrar">Registrar solicitud</button>
		</div>
	</div>
</div>

<div class="offcanvas offcanvas-end offcanvas-custom" id="div-modal-tarifa" aria-labelledby="tarifaModal" data-bs-backdrop="true">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title fw-bold" id="tituloNuevaTarifaModal">Editar Tarifa</h5>
		<button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body d-flex flex-column">
		<input type="hidden" id="input-idcurso-editar" />
		<div class="row">
			<div class="col-md-12 mt-4">
				<div class="form-floating">
					<select class="form-select" id="sel-organizacion-editar" placeholder disabled>
						@foreach (var organizacion in organizaciones?.ToList())
						{
							<option value="@organizacion.Key">@organizacion.Value</option>
						}
					</select>
					<label for="sel-organizacion-editar">Organizaci&oacute;n</label>
				</div>
			</div>
			<div class="col-md-12 mt-4">
				<div class="form-floating">
					<select class="form-select" id="sel-periodo-editar" placeholder disabled>
					</select>
					<label for="sel-periodo-editar">Periodo</label>
				</div>
			</div>
			<div class="col-md-12 mt-4">
				@* <div class="form-floating">
                    <select class="form-select" id="sel-curso-editar" placeholder disabled>
                    </select>
                    <label for="sel-curso-editar" style="top:-5px;">Curso</label>
                </div> *@
				<div class="input-group input-group-typeahead-icon">
					<span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
					<input type="text" id="input-curso-editar" class="form-control" placeholder="Código o nombre de curso" disabled>
				</div>
			</div>
			<div class="col-md-12 mt-4">
				<div class="form-floating">
					<select class="form-select" id="sel-tipo-sesion-editar">
						<option value="">Seleccione</option>
						<option value="Síncrono">Síncrono</option>
						<option value="Asíncrono">Asíncrono</option>
						<option value="Ambos">Ambos</option>
					</select>
					<label for="sel-tipo-sesion-editar">Tipo de Sesión</label>
				</div>
			</div>
			<div class="col-md-12 mt-4">
				<div class="form-floating">
					<input type="text" id="input-tarifa-editar" class="form-control" placeholder>
					<label for="input-tarifa-editar">Tarifa</label>
				</div>
			</div>
		</div>
		<div class="row mt-auto">
			<div class="col-md-6 mt-2">
				<button class="btn btn-primary form-control" id="btn-guardar-editar">Guardar</button>
			</div>
			<div class="col-md-6 mt-2">
				<button type="button" class="btn btn-outline-primary form-control" data-bs-dismiss="offcanvas">Cancelar</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/typeahead/typeahead.jquery.js" asp-append-version="true"></script>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/corejs-typeahead/1.2.1/bloodhound.min.js"></script>
	<script src="~/js/workflow/service/util-service.js" asp-append-version="true"></script>
	<script src="~/js/workflow/service/tarifa-curso-service.js" asp-append-version="true"></script>
	<script src="~/js/workflow/tarifa-curso/tarifa-curso-index.js" asp-append-version="true"></script>
	<script src="~/js/workflow/constantes.js" asp-append-version="true"></script>
}