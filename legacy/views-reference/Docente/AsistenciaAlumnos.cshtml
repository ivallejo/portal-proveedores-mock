        const listHorarioSesionesView = "@Url.Action("SESSIONS_SCHEDULE","Docente")"; //invoca a la vista parcial
        const listadoAsistentesSesion = "@Url.Action("list_asistents","Docente")";

        const sendJsonStudents = "@Url.Action("marcar_asistencia","Docente")"; //para marcar asistencia en fx a un json

        const generateReporteEstudiantes = "@Url.Action("generateReporteEstudiantes", "Docente")";
         
    </script>
}