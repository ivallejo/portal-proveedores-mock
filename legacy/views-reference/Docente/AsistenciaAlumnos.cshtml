<div class="data-tabs mt-4">

    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sections-tab" data-bs-toggle="tab" data-bs-target="#sections" type="button" role="tab" aria-controls="sections" aria-selected="true">Secciones</button>
        </li>
        <li id="tab_asistencia" class="nav-item d-none" role="presentation">
            <button class="nav-link" id="asists-tab" data-bs-toggle="tab" data-bs-target="#asists" type="button" role="tab" aria-controls="asists" aria-selected="false">Asistencia</button>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent"> 

        <div class="tab-pane fade show active" id="sections" role="tabpanel" aria-labelledby="sections-tab">
             @await Html.PartialAsync("_asists_sections")
        </div>

        <div class="tab-pane fade" id="asists" role="tabpanel" aria-labelledby="asists-tab">
            @await Html.PartialAsync("_asists_alumnos")
        </div>

    </div>

</div>


<!-- Modal para mostrar la imagen en grande -->
<div id="photoModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="photoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="photoModalLabel">Foto</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center">
                <img id="modalPhoto" src="" alt="Foto grande" style="max-width: 100%; height: auto;">
            </div>
        </div>
    </div>
</div>



@section Scripts{
    <script src="~/js/Docente/AlumnoAsists.js?v=@Guid.NewGuid().ToString();"></script>

    <!--peticiones ajax-->
