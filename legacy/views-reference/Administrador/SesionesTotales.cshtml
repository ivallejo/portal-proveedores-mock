@{
    // ViewData["Title"] = "Sesiones Totales";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    //Layout = "~/Views/Shared/NewLayout.cshtml";
    Layout = "~/Views/Shared/_Layout_Intranet.cshtml";

}
<style>

    @@media (min-width: 1400px) {
        .container-xxl, .container-xl, .container-lg, .container-md, .container-sm, .container {
            max-width: 100%;
        }
    }

    .table > thead {
        vertical-align: middle;
    }

</style>

<input value="@Url.Action("DescargarExcelSesiones","Administrador")" id="inputDescargarExcelSesiones" hidden />
@* <input value="@Url.Action("DescargarExcelJustificaciones","Administrador")" id="inputDescargarExcelJustificaciones" hidden /> *@
<input value="@Url.Action("ExcelSesionesTotales","WkSolicitud")" id="inputDescargarExcelJustificaciones" hidden />

@* <div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-th-list"></i>
        @ViewData["Title"]
    </h1>
</div> *@

<div class="card container mt-4">

    <div class="card-body">

        <div class="row">
            <div class="col-sm-4 form-group">
                <label for="txtDocente" class="form-label">Unidad de negocio:</label>
                <select id="cboUnidadNegocio" class="form-control form-select" data-bs-placeholder="Seleccione Unidad de Negocio">
                    <option value="INS">Instituto</option>
                    <option value="ECA">Escuela Adex</option>
                    <option value="ESC">Escuela</option>
                </select>
            </div>
            <div class="col-sm-4 form-group">
                <label for="txtFechaIni" class="form-label">Fecha Inicio:</label>
                <input type="date" class="form-control" id="txtFechaIni" value="">
            </div>
            <div class="col-sm-4 form-group">
                <label for="txtFechaFin" class="form-label">Fecha Fin:</label>
                <input type="date" class="form-control" id="txtFechaFin" value="">
            </div>
        </div>
        <button class="btn btn-primary mt-4 mb-0" id="btnExportarSesiones">Exportar Todas las Sesiones a Excel</button>
        <button class="btn btn-primary mt-4 mb-0" id="btnExportarJustificaciones">Exportar Todas las Justificaciones a Excel</button>

    </div>
</div>


@section Scripts{
    <script src="~/js/SesionesTotales.js" type="module"></script>

}
