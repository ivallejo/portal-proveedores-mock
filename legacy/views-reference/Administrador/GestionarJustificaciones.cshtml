@{
    ViewData["Title"] = "Gestionar Justificaciones";
    //Layout = "~/Views/Shared/_Layout.cshtml";
    //Layout = "~/Views/Shared/NewLayout.cshtml";
    Layout = "~/Views/Shared/_Layout_Intranet.cshtml";

}

<div class="page-header">
    <h1 class="page-title">
        <i class="fas fa-file-signature"></i>
        @ViewData["Title"]
    </h1>
</div>
@*<div class="col-md-12 card container-fluid">*@
<div class="col-md-12 card container">

    <div class="card-body">

        <div class="row">
            <div class="col-sm-4 form-group">
                <label for="cboEstado" class="form-label">Estado:</label>
                <select id="cboEstado" class="form-control form-select" data-bs-placeholder="Seleccione un Estado">
                    <option value="P">Pendiente</option>
                    <option value="A">Aprobada</option>
                    <option value="D">Denegada</option>
                </select>
            </div>
            <div class="col-sm-4 form-group">
                <label for="cboPeriodo" class="form-label">Periodo:</label>
                <select id="cboPeriodo" class="form-control form-select" data-bs-placeholder="Seleccione un Periodo">
                    <option value="-1">Seleccione un Periodo</option>
                </select>
            </div>
            <div class="col-sm-4 form-group">
                <label for="txtDocente" class="form-label">Docente:</label>
                <input type="text" class="form-control" id="txtDocente">
            </div>
        </div>
        <button class="btn btn-primary mt-4 mb-4" id="btnConsultar">Consultar</button>
        <style>


            .table thead th {
                font-size: 11px !important;
                white-space: pre-line;
                vertical-align: middle;
                text-align: center;
            }

            .table tbody td {
                font-size: 11px !important;
                white-space: pre-line;
                vertical-align: middle;
                text-align: center;
                line-height: 0.85rem !important;
            }
        </style>
        <div class="table-responsive">
        </div>

    </div>
</div>


@section Scripts{
    <script src="~/js/GestionarJustificaciones.js" type="module"></script>

}
