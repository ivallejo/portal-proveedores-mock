@section Scripts{
    <script src="~/js/Admin/admin_docente_calendar.js?v=1.4.0"></script>

    <!--functions para la carga de horario-->
    <!--OK_-->
    <script>
        const getSchedule = "@Url.Action("GetScheduleDocente", "Administrador")"
        const getSchedule_data = "@Url.Action("GetScheduleData", "Administrador")"
        const searchChildSections = "@Url.Action("GetSeccionesHijasDocente", "Administrador")";
    </script>

    <script>
        $(document).ready(async function () {
            for (var item of organizations) {
                var random = Math.floor(Math.random() * 2024);
                var anio = item.Anio;
                var semestre = item.Semestre;
                var target = "#result" + anio + semestre;
                var print_target = anio + semestre + random;
                // var print_target = '@print_target';
                var loaderId = "idloadingHorario_" + anio + '-' + semestre;

                try {
                    showModalLoader();
                    await cargarhorariopost(target, anio, semestre, print_target, loaderId); // Esperar a que termine antes de continuar
                } catch (error) {
                    console.error("Error al cargar horario:", error);
                }
            }
        });



    </script>

    <script>
        // Configurar código inicial
        $(document).ready(function() {
            // Forzar recarga limpia al volver
            if(performance.navigation.type === 2){
                sessionStorage.removeItem('reloading');
                location.reload();
            }
            
            // Manejar botón de carga
            $('#cargarHorarioBtn').click(function () {
                const codDocente = $('#codDocenteInput').val();
                if(!codDocente) {
                    alert('Por favor ingrese un código de docente');
                    return;
                }
                
                $.post('@Url.Action("SetDocenteSession", "Administrador")', 
                    { codDocente: codDocente }, 
                    function() {
                        sessionStorage.setItem('reloading', 'true');
                        location.reload();
                    }
                );
            });
        });
    </script>

    <script>
        // Limpiar sesión al recargar
        window.onbeforeunload = function() {
            sessionStorage.removeItem('reloading');
        }
    </script>

    <script>
        // Configurar código inicial
$(document).ready(function() {
    // Cargar datos iniciales si existen en sesión
    const currentCodDocente = '@Context.Session.GetString("CurrentCodDocente")';
    if (currentCodDocente) {
        cargarDatosDocente(currentCodDocente);
    }

    // Manejar botón de carga
    $('#cargarHorarioBtn').click(async function() {
        const codDocente = $('#codDocenteInput').val();
        if (!codDocente) {
            alert('Por favor ingrese un código de docente');
            return;
        }
        
        try {
            const response = await $.post('@Url.Action("SetDocenteSession", "Administrador")', { 
                codDocente: codDocente 
            });

            if (response.success) {
                // Actualizar UI sin recargar
                $('#docenteNombre').text(response.nombre);
                $('#docenteCodigo').text(response.codigo);
                $('#docenteDNI').text(response.dni);
                $('#docenteInfo').fadeIn();
                
                // Recargar solo la sección del horario
                await recargarHorario();
            }
        } catch (error) {
            console.error("Error:", error);
        }
    });
});

async function recargarHorario() {
    try {
        // Limpiar contenido previo
        $('#nav-tab, #nav-tabContent').empty();
        
        // Obtener y renderizar nuevo horario
        const response = await $.get('@Url.Action("DocenteHorario", "Administrador")');
        $('#nav-tabContent').html($(response).find('#nav-tabContent').html());
        $('#nav-tab').html($(response).find('#nav-tab').html());
        
        // Re-inicializar componentes si es necesario
    } catch (error) {
        console.error("Error al recargar horario:", error);
    }
}

async function cargarDatosDocente(codDocente) {
    try {
        const response = await $.get('@Url.Action("GetDatosDocente", "Administrador")', {
            codDocente: codDocente
        });
        
        $('#docenteNombre').text(response.nombre);
        $('#docenteCodigo').text(response.codigo);
        $('#docenteDNI').text(response.dni);
        $('#docenteInfo').fadeIn();
    } catch (error) {
        console.error("Error cargando datos docente:", error);
    }
}
    </script>

    <script>
    $("#codDocenteInput").autocomplete({
    source: function (request, response) {
        $.ajax({
            url: 'ListarDocenteCodeNameCode',
            method: "GET",
            data: { filter: request.term },
            success: function (data) {
                if (data.success) {
                    const sugerencias = data.resultado.map(docente => ({
                        label: docente.nameCodeDocente, // Muestra el nombre + código
                        value: docente.codeDocente // Valor real a enviar (código)
                    }));
                    response(sugerencias);
                } else {
                    console.error(data.resultado);
                    response([]);
                }
            },
            error: function (error) {
                console.log(error);
                response([]);
            }
        });
    },
    minLength: 2,
    select: function(event, ui) {
        event.preventDefault();
        $(this).val(ui.item.value); // Establece el valor del input como el código
        // Alternativa si quieres mostrar el nombre pero guardar el código:
        // $(this).val(ui.item.label);
        // $("#codDocenteHidden").val(ui.item.value);
    },
    focus: function(event, ui) {
        event.preventDefault();
        $(this).val(ui.item.label); // Muestra el nombre completo al navegar
    }
});
    </script>

}
