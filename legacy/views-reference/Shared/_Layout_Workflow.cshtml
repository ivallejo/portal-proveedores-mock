	@* ESTILOS PERSONALIZADOS PARA EL BUSCADOR Y PAGINACION DATATABLE *@
	<style>
		/* Contenedor del filtro */
		.dataTables_filter {
			display: flex;
			justify-content: center;
			margin: 10px 0;
		}

		.dataTables_wrapper .dataTables_filter input {
			margin-left: 0px;
		}

		/* Ocultar el texto "Buscar:" del label */
		.dataTables_filter label {
			position: relative;
			width: 100%;
			max-width: 400px; /* Ajusta el ancho máximo */
			color: transparent; /* Oculta el texto original */
		}

		/* Input de búsqueda */
		.dataTables_filter input[type="search"] {
			width: 100%;
			padding: 10px 12px 10px 35px; /* Espacio para el ícono a la izquierda */
			border: 1px solid #ccc !important;
			border-radius: 20px !important;
			font-size: 14px !important;
			outline: none !important;
			transition: all 0.3s ease !important;
			box-shadow: 0 0 5px rgba(0, 0, 0, 0.1) !important;
		}

		/* Ícono de búsqueda dentro del input */
		.dataTables_filter label::before {
			content: '\1F50D'; /* Unicode del ícono de búsqueda (lupa) */
			font-size: 16px;
			color: #888;
			position: absolute;
			left: 10px;
			top: 50%;
			transform: translateY(-50%);
		}

		/* Efecto hover */
		.dataTables_filter input[type="search"]:hover {
			border-color: #888 !important;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.2) !important;
		}




		/* Contenedor general de la paginación */
		.dataTables_paginate {
			display: flex !important;
			justify-content: center !important;
			align-items: center !important;
			gap: 5px !important; /* Espacio entre los botones */
		}

			/* Estilo para los botones de paginación */
			.dataTables_paginate a.paginate_button {
				display: inline-block !important;
				padding: 6px 12px !important;
				margin: 0 3px !important;
				text-decoration: none !important;
				font-size: 14px !important;
				color: #007BFF !important; /* Color de texto de Bootstrap */
				background-color: #fff !important; /* Fondo blanco */
				border: 1px solid #ccc !important; /* Borde gris */
				border-radius: 0.25rem !important; /* Bordes redondeados */
				transition: all 0.3s ease !important;
			}

				/* Botón activo (página actual) */
				.dataTables_paginate a.paginate_button.current {
					color: #fff !important;
					background-color: #007BFF !important; /* Fondo azul */
					border-color: #007BFF !important; /* Borde azul */
					cursor: default !important;
				}

				/* Botón en estado deshabilitado */
				.dataTables_paginate a.paginate_button.disabled {
					color: #6c757d !important; /* Color gris para texto deshabilitado */
					background-color: #e9ecef !important; /* Fondo gris claro */
					border-color: #ddd !important; /* Borde gris claro */
					cursor: not-allowed !important; /* Cursor de no permitido */
				}

				/* Botones al pasar el mouse (hover) */
				.dataTables_paginate a.paginate_button:hover:not(.disabled):not(.current) {
					color: #0056b3 !important; /* Color de texto al hacer hover */
					background-color: #f8f9fa !important; /* Fondo gris claro al hacer hover */
					border-color: #007BFF !important; /* Borde azul al hacer hover */
				}

			/* Estilo para elipsis (...) */
			.dataTables_paginate .ellipsis {
				padding: 6px 12px !important;
				color: #6c757d !important; /* Color gris claro */
				background-color: transparent !important;
				border: none !important;
				cursor: default !important;
			}

			/* Botones de navegación (Anterior/Siguiente) */
			.dataTables_paginate a.paginate_button.previous,
			.dataTables_paginate a.paginate_button.next {
				font-weight: bold !important;
			}

		/* Estilo adicional para el contenedor de la paginación */
		.dataTables_wrapper .dataTables_paginate {
