@using Newtonsoft.Json;
@using SAD_BE;

@{
	string slug_auxiliar = Context.Session.GetString("slug_aux") ?? "";

	string fullName = Context.Session.GetString("FullName") ?? "";
	string userName = Context.Session.GetString("UserName") ?? "";
	string mail = Context.Session.GetString("Mail") ?? "";
	string peopleId = Context.Session.GetString("PeopleID") ?? "";
	string imgProfile = Context.Session.GetString("ImgProfile") ?? "";
	string prefixUrl = "../images";
	string session = Context.Session.GetString("attrSession") ?? "";

	var attr = JsonConvert.DeserializeObject<SessionAttr>(session);

	string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
	string action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
	var rutaMapeable = $"{controller}/{action}";

	Menu context_menu = attr.menus.Find(m => m.url.Contains(rutaMapeable)) ?? new Menu();
	string title_menu = context_menu.menu;
	string description = context_menu.description;
	string icon = context_menu.src;

	// throw new Exception("Simulación de error en el layout");
}
