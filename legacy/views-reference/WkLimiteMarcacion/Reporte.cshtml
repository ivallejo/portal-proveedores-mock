@{
	Layout = "~/Views/Shared/_Layout_Workflow.cshtml";
	var organizaciones = (IEnumerable<KeyValuePair<string, string>>)ViewBag.Organizaciones;
	var estadosSolicitud = (IEnumerable<KeyValuePair<int, string>>)ViewBag.EstadoSolicitud;
}
<style>
	.fa-eye {
		font-size: 1.14em;
	}

	.custom-switch {
		transform: scale(1.8);
	}

	.form-switch {
		padding-left: 4em;
	}

	.input-group {
		align-items: center;
		height: 100%;
	}
</style>
<div id="divContent">
	<div class="row">
		<div class="col-md-10">
			<h3 class="fw-bold">
				Reporte de L&iacute;mites de Marcaci&oacute;n
			</h3>
		</div>
	</div>
	<div class="row mt-4">
		<div class="col-sm-12 col-md-5">
			<div class="fw-bold">
				Ingresa la información solicitada
			</div>
		</div>
	</div>
	<div class="row">
		<div class="col-md-3 mt-2">
			<div class="input-group">
				<span class="input-group-text bg-white">Organización:</span>
				<select class="form-select" id="sel-organizacion">
					@foreach (var organizacion in organizaciones?.ToList())
					{
						<option value="@organizacion.Key">@organizacion.Value</option>
					}
				</select>
			</div>
		</div>
		<div class="col-md-3 mt-2">
			<div class="input-group">
				<span class="input-group-text bg-white">Periodo:</span>
				<select class="form-select" id="sel-periodo">
				</select>
			</div>
		</div>
		<div class="col-md-3 mt-2">
			<div class="input-group">
				<span class="input-group-text bg-white">Estado:</span>
				<select class="form-select" id="sel-estado">
					@foreach (var estadoSol in estadosSolicitud?.ToList())
					{
						<option value="@estadoSol.Key">@estadoSol.Value</option>
					}
				</select>
			</div>
		</div>
		<div class="col-md-2 mt-2">
			<div class="input-group">
				<div class="col-sm-6 col-md-6">
					<span style="font-size:1rem;">Tarifa final:</span>
				</div>
				<div class="col-sm-6 col-md-6">
					<div class="form-check form-switch">
						<input class="form-check-input custom-switch" type="checkbox" role="switch" id="check-final" />
					</div>
				</div>
			</div>
		</div>
		<div class="col-md-1 mt-2">
			<button class="btn btn-primary form-control" id="btn-buscar">Buscar</button>
		</div>
	</div>
	<div class="col-md-2 mt-4">
		<a class="btn btn-primary form-control" id="btn-exportar" href="" target="_blank"><i class="fas fa-file-excel"></i> Exportar</a>
	</div>
	<div class="card card-index mt-2 card-worklow">
		<div class="card-body">
			<div id="registroTarifa">
				<div class="table-responsive table-responsive-workflow">
					<table id="tbl-items" class="table text-nowrap table-workflow" style="width:100%;">
					</table>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="offcanvas offcanvas-end offcanvas-custom" id="modal-detalle" aria-labelledby="tarifaDocenteModalLabel" data-bs-backdrop="true">
	<div class="offcanvas-header">
		<h5 class="offcanvas-title fw-bold">Detalle de L&iacute;mites de Marcaci&oacute;n</h5>
		<button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
	</div>
	<div class="offcanvas-body d-flex flex-column">
		<div class="">
			<div class="row mt-2">
				<div class="col-md-12">
					<div class="form-floating">
						<input type="text" class="form-control edit-control" id="input-nombreorganizacion" data-val="true" placeholder="" disabled />
						<label for="sel-organizacion">Organizaci&oacute;n</label>
					</div>
				</div>
			</div>
			<div class="row mt-4">
				<div class="col-md-12">
					<div class="form-floating">
						<input type="text" class="form-control edit-control" id="input-nombreperiodo" data-val="true" placeholder="" disabled />
						<label for="sel-periodo">Periodo</label>
					</div>
				</div>
			</div>
			<div class="row mt-4">
				<div class="col-md-6">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-minantesentrada" data-val="true" placeholder="" required disabled />
						<label for="input-minantesentrada">Minutos antes de entrada</label>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-mindespuesentrada" data-val="true" placeholder="" required disabled />
						<label for="input-mindespuesentrada">Minutos despu&eacute;s de entrada</label>
					</div>
				</div>
			</div>
			<div class="row mt-4">
				<div class="col-md-6">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-minantessalida" data-val="true" placeholder="" required disabled />
						<label for="input-minantessalida">Minutos antes de salida</label>
					</div>
				</div>
				<div class="col-md-6">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-mindespuessalida" data-val="true" placeholder="" required disabled />
						<label for="input-mindespuessalida">Minutos despu&eacute;s de salida</label>
					</div>
				</div>
			</div>
			<div class="row mt-4">
				<div class="col-md-6">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-factorturnomanana" data-val="true" placeholder="" required disabled />
						<label for="input-factorturnomanana">Factor de turno mañana</label>
					</div>
				</div>
				<div class="col-md-6" id="divFactorTarde">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-factorturnotarde" data-val="true" placeholder="" required disabled />
						<label for="input-factorturnotarde">Factor de turno tarde</label>
					</div>
				</div>
			</div>
			<div class="row mt-4" id="divRowFactorNoche">
				<div class="col-md-12">
					<div class="form-floating">
						<input type="number" class="form-control edit-control" id="input-factorturnonoche" data-val="true" placeholder="" required disabled />
						<label for="input-factorturnonoche">Factor de turno noche</label>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="~/js/workflow/constantes.js" asp-append-version="true"></script>
	<script src="~/js/workflow/service/util-service.js" asp-append-version="true"></script>
	<script src="~/js/workflow/service/solicitud-service.js" asp-append-version="true"></script>
	<script src="~/js/workflow/service/limite-marcacion-service.js" asp-append-version="true"></script>
	@* <script src="~/js/workflow/service/periodo-academico-service.js" asp-append-version="true"></script> *@
	<script src="~/js/workflow/limite-marcacion/limite-marcacion-reporte.js" asp-append-version="true"></script>
}