@{
    ViewData["Title"] = "Grupo de Usuarios";
    Layout = "~/Views/Shared/_Layout_Workflow.cshtml";
}
<link href="~/css/workflow/typeahead.css" rel="stylesheet" />
<div id="divContent">
    <div class="row">
        <div class="col-md-10">
            <h3 class="fw-bold">
                Grupos de usuarios
            </h3>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary form-control" id="btnNuevo">Nuevo grupo</button>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-7 mt-2">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                <input type="text" id="FiltroGrupo" class="form-control" placeholder="Nombre del grupo">
            </div>
        </div>
        <div class="col-md-3 mt-2">
            <div class="input-group">
                <span class="input-group-text bg-white">Estado:</span>
                <select class="form-select" id="FiltroEstado">
                    <option value="">Todos</option>
                    <option value="1">Activos</option>
                    <option value="0">Inactivos</option>
                </select>
            </div>
        </div>
        <div class="col-md-2 mt-2">
            <button class="btn btn-primary form-control" id="btnBuscar">Buscar</button>
        </div>
    </div>

    <div id="wkGrupoUsuarioContainer" class="card card-index mt-4 d-none card-worklow">
        <div class="card-body">
            <div id="marcacionesDocente">
                <div class="table-responsive table-responsive-workflow">
                    <table id="wkGrupoUsuarioTable" class="table text-nowrap table-workflow" style="width:100%;">
                    </table>
                </div>
                <div id="wkGrupoUsuarioCard" class="table-cards">
                    <div id="contentCards-grupoUsuario">
                    </div>
                    <div class="dataTables_paginate paging_simple_numbers">
                        <ul class="pagination" id="paginationCard">
                            <!-- Links de paginación se generarán aquí -->
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/typeahead/typeahead.jquery.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/corejs-typeahead/1.2.1/bloodhound.min.js"></script>
    <script src="~/js/workflow/service/util-service.js" asp-append-version="true"></script>
    <script src="~/js/workflow/service/grupo-usuario-service.js" asp-append-version="true"></script>
    <script src="~/js/workflow/grupo-usuario/grupo-usuario-index.js" asp-append-version="true"></script>
}