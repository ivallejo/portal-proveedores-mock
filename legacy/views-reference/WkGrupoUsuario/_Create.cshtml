
<form autocomplete="off" id="frmAccion">
    <div class="offcanvas offcanvas-end offcanvas-custom" id="nuevoGrupoModal" aria-labelledby="nuevoGrupoModalLabel" data-bs-backdrop="true">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold" id="tituloNuevoGrupoModal">Nuevo Grupo</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            @* <input type="hidden" id="IdGrupo"/> *@
            <div class="row">
                <div class="col-md-12 mb-2"><h6 class="fw-bold title-seccion">Datos generales</h6></div>
                <div class="col-md-12">
                    <div class="form-floating">
                        <input type="text" class="form-control" required id="Nombre" data-val="true" placeholder="">
                        <label for="Nombre">Nombre del grupo</label>
                    </div>

                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-12">
                    <label class="">Estado</label>
                    <div class="mt-1">
                        <div class="form-check-inline">
                            <label class="container-radio">
                                Activo
                                <input type="radio" id="Activo" name="Estado" checked class="form-check-input" value="1" />
                                <span class="checkmark"></span>
                            </label>
                        </div>
                        <div class="form-check-inline">
                            <label class="container-radio">
                                Inactivo
                                <input type="radio" id="Inactivo" name="Estado" class="form-check-input" value="0" />
                                <span class="checkmark"></span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-md-12 mb-2"><h6 class="fw-bold title-seccion">Datos de usuarios</h6></div>
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-9 mt-2">
                            <div class="input-group input-group-typeahead-icon">
                                <span class="input-group-text bg-white"><i class="fas fa-search"></i></span>
                                <input type="text" class="form-control" id="Usuario" placeholder="Código o nombre de usuario">
                            </div>
                        </div>
                        <div class="col-md-3 mt-2">
                            <button type="button" class="btn btn-primary form-control" id="btnAgregarUsuario">Agregar</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-md-12 table-responsive">
                    <table id="tblUsuarios" class="table table-workflow" style="width:100%;">
                    </table>
                </div>
            </div>
            <div class="row mt-auto">
                <div class="col-md-6 mt-2">
                    <button class="btn btn-primary form-control" id="btnGuardar">Guardar</button>
                </div>
                <div class="col-md-6 mt-2">
                    <button type="button" class="btn btn-outline-primary form-control" data-bs-dismiss="offcanvas">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</form>
<script src="~/js/workflow/grupo-usuario/grupo-usuario-create.js" asp-append-version="true"></script>