<form autocomplete="off" id="frmRechazoSolicitud">
    <div class="offcanvas offcanvas-end offcanvas-custom" id="rechazoSolicitudModal" aria-labelledby="rechazoSolicitudModalLabel" data-bs-backdrop="true">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold">Rechazar Solicitud</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div class="row">
                <div class="col-md-12 mt-2">
                    <div class="form-floating">
                        <select class="form-select" required id="IdMotivoRechazoSolicitud" name="IdMotivoRechazoSolicitud" data-val="true" placeholder="">
                        </select>
                        <label for="IdMotivoRechazoSolicitud">Motivo de rechazo</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <textarea class="form-control" maxlength="400" rows="3" id="ComentarioAtencion" name="ComentarioAtencion" data-val="true" placeholder="" required></textarea>
                        <label for="ComentarioAtencion">Descripción de motivo</label>
                    </div>
                </div>
            </div>
            <div class="row mt-auto">
                <div class="col-md-6 mt-2">
                    <button type="button" class="btn btn-primary form-control" id="btnRechazarSolicitud">Rechazar</button>
                </div>
                <div class="col-md-6 mt-2">
                    <button type="button" class="btn btn-outline-primary form-control" data-bs-dismiss="offcanvas">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</form>
<script src="~/js/workflow/aprobacion-solicitud/rechazo-solicitud-modal.js" asp-append-version="true"></script>