@{
    ViewData["Title"] = "Aprobación de Solicitudes";
    Layout = "~/Views/Shared/_Layout_Workflow.cshtml";
}
<link href="~/lib/bootstrap-daterangepicker/daterangepicker.min.css" rel="stylesheet" />
<div id="divContent">
    <div class="row">
        <div class="col-md-12">
            <h3 class="fw-bold">
                @ViewData["Title"]
            </h3>
        </div>
    </div>
    <div class="row mt-2">

        <div class="col-md-4 mt-2">
            <div class="input-group">
                <span class="input-group-text bg-white">Nombre de flujo:</span>
                <select class="form-select" id="FiltroWorkflow">
                </select>
            </div>
        </div>
        <div class="col-md-4 mt-2">
            <div class="input-group">
                <span class="input-group-text bg-white">Fechas de solicitud:</span>
                <input type="text" id="filtroFecha" class="form-control" />
                @* <select class="form-select" id="FiltroEstado">
                </select> *@
            </div>
        </div>
        <div class="col-md-2 mt-2">
            <div class="input-group">
                <span class="input-group-text bg-white">Masivo:</span>
                <select class="form-select" id="FiltroMasivo">
                </select>
            </div>
        </div>
        <div class="col-md-2 mt-2">
            <button class="btn btn-primary form-control" id="btnBuscar">Buscar</button>
        </div>

    </div>

    <div id="aprobacionContainer" class="card card-index mt-4 d-none card-worklow">
        <div class="card-body">
            <div class="row">
                <div class="col-md-12 mt-2 text-center">
                    <button class="btn btn-primary ctrl-masivo d-none" id="btn-aprobar-masivo">Aprobar</button>
                    <button class="btn btn-outline-primary ctrl-masivo d-none" id="btn-rechazar-masivo">Rechazar</button>
                </div>
            </div>
            <div>
                <div class="table-responsive table-responsive-workflow">
                    <table id="wkAprobacionTable" class="table table-workflow" style="width:100%;">
                    </table>
                </div>
                <div id="wkAprobacionCard" class="table-cards">
                    <div id="contentCards-aprobacion">
                    </div>
                    <div class="dataTables_paginate paging_simple_numbers">
                        <ul class="pagination" id="paginationCard">
                            <!-- Links de paginación se generarán aquí -->
                        </ul>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 mt-2">
                    <div class="alert alert-secondary alert-dismissible fade show d-none" role="alert" id="div-masivo-result">
                        <div id="div-masivo-result-content"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<partial name="_RechazoSolicitud.cshtml"></partial>
<partial name="_AprobacionMasiva.cshtml"></partial>
@section Scripts {
    <script type="text/javascript">
        const keyEvaluar = '@ViewBag.key';
    </script>
    <script src="~/js/workflow/service/util-service.js" asp-append-version="true"></script>
    <script src="~/js/workflow/service/workflow-service.js" asp-append-version="true"></script>
    <script src="~/js/workflow/service/fase-workflow-service.js" asp-append-version="true"></script>
    <script src="~/js/workflow/service/motivo-rechazo-solicitud-service.js" asp-append-version="true"></script>
    <script src="~/js/workflow/constantes.js" asp-append-version="true"></script>
    <script src="~/js/workflow/service/solicitud-service.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap-daterangepicker/moment.min.js"></script>
    <script src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>
    <script src="~/js/workflow/aprobacion-solicitud/aprobacion-solicitud-index.js" asp-append-version="true"></script>
}
