@using SAD_Utils
@{
    var identificadores = new List<KeyValuePair<string, string>>() {
                    new KeyValuePair<string, string>(
                        ConstantesWorkflow.ReprogramacionSolicitudIdentificador.AdelantoClases, "Adelanto de Clases"),
                    new KeyValuePair<string, string>(
                        ConstantesWorkflow.ReprogramacionSolicitudIdentificador.RecuperacionClases, "Recuperación de Clases") };
}
<form autocomplete="off" id="frmReprogramacionClases">
    <div class="offcanvas offcanvas-end offcanvas-custom" id="reprogramacionClasesModal" aria-labelledby="reprogramacionClasesModalLabel" data-bs-backdrop="true">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title fw-bold">Aprobar o Rechazar</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <div class="row">
                <partial name="_DatosSolicitud.cshtml"></partial>
                <div class="col-md-12 mt-4"><h6 class="fw-bold title-seccion">Datos de reprogramación</h6></div>
                <div class="col-md-12 mt-3">
                    <div class="form-floating">
                        <input type="text" id="Sesion" name="Sesion" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Sesión</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <select class="form-select" required id="Identificador" name="Identificador" disabled data-val="true" placeholder="">
                            @if (identificadores != null)
                            {
                                foreach (var identificador in identificadores)
                                {
                                    <option value="@identificador.Key">@identificador.Value</option>
                                }
                            }
                        </select>
                        <label for="Workflow">Identificador</label> 
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="text" id="JefeDirecto" name="JefeDirecto" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Nombre de jefe directo</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="text" id="ProgramaAcademico" name="ProgramaAcademico" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Programa Académico</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="text" id="Tema" name="Tema" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Tema</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="date" id="FechaRecuperacion" name="FechaRecuperacion" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Fecha y día de Recuperación</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="text" id="HoraInicio" name="HoraInicio" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Hora de inicio</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="text" id="HoraFin" name="HoraFin" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Hora fin</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <input type="text" id="CantidadEstudiantes" name="CantidadEstudiantes" data-val="true" disabled placeholder="" required class="form-control" />
                        <label for="Workflow">Cantidad de estudiantes</label>
                    </div>
                </div>
                <div class="col-md-12 mt-4">
                    <div class="form-floating">
                        <textarea class="form-control" rows="3" id="MotivoReprogramacion" disabled name="MotivoReprogramacion" data-val="true" placeholder="" required></textarea>
                        <label for="Workflow">Motivo de reprogramación</label>
                    </div>
                </div>
                <div class="col-md-3 mt-3"></div>
                <div class="col-md-6 mt-3">
                    <a class="btn btn-primary form-control" id="btnExportar" target="_blank"><i class="fas fa-file-excel"></i> Exportar Solicitud</a>
                </div>
            </div>
            <partial name="_AccionesSolicitud.cshtml"></partial>
        </div>
    </div>
</form>
<script src="~/js/workflow/aprobacion-solicitud/aprobacion-solicitud-reprogramacion-clases.js" asp-append-version="true"></script>