@{
    Layout = null;
    var requestLogin = Url.Action("Login", "Auth");

    string slug_auxiliar = ViewBag.slug_aux as string ?? "";
    string fondoWeb = $"../{slug_auxiliar}img/fondoweb.jpg";
    string fondoMobile = $"../{slug_auxiliar}img/fondo_adex_mobile.png";
    string footer = $"{DateTime.Now.Year}  | ADEX";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Instituto Adex, Adex">
    <meta name="author" content="LPISoft">
    <link rel="shortcut icon" href="~/images/favicon.ico">
    <title>Login</title>
    <link href="~/css/login.css?ver=2" rel="stylesheet">
    <link href="~/css/login2.css?ver=2" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Roboto" rel="stylesheet">
    <script src="~/lib/jquery/dist/jquery.js"></script>
    <script src="~/js/oauth.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
</head>
<body>
    <input type="hidden" value="0" id="hdfval" />
    <div class="d-block d-sm-none">

        <div class="login" style="background: url('@fondoMobile') no-repeat center center fixed;background-size:cover;">
            <main class="main" id="top">
                <div class="container-fluid">
                    <div class="row">
                        <div class="text-center" style="margin-top:40%;">
                            <img src="~/images/logo.png" style="max-height:183px;max-width:244px" />
                        </div>
                    </div>
                    <div style="margin-top:5%;margin:5% 5% 5% 8%">
                        <div class="col-xs-12" style="font-size:34px;color:#207fe9;font-weight:bold;">
                            ¡Bienvenido(a) a ADEX Intranet - Docente!
                        </div>
                        <div class="col-xs-12" style="font-size:20px;color:#207fe9;">
                            Escribe tus datos para ingresar
                        </div>
                    </div>
                    <div class="form-group" style="margin:5%;margin-bottom:0px !important;">
                        <div class="input-icon">
                            <span class="icon-user">
                                <img src="~/img/user2.png" height="24" width="24" />
                            </span>
                            <input class="form-control" style="height:48px !important;padding: 6px 40px !important;" id="Usuario2" type="text" placeholder="Código de docente" required>
                        </div>
                    </div>
                    <div class="form-group" style="margin:5%">
                        <div class="input-icon">
                            <span class="icon-user">
                                <img src="~/img/padlock.png" height="24" width="24" />
                            </span>
                            <input class="form-control" style="height:48px !important;padding: 6px 40px !important;" id="card-password2" type="password" placeholder="Contraseña" required>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-lg-12 text-center" style="padding:5%;display:none;" id="divMensajesesion2"></div>
                    </div>
                    <div class="col-xs-12" style="margin:5%">
                        <input class="btn-login d-block w-100 mt-3" style="height:48px !important" id="btn-sendlogin" type="submit" name="submit" onclick="ValidarCredenciales2('@requestLogin')" value="Ingresar" />
                    </div>
                    <div class="row" style="margin:12% 5% 5% 5%">
                        <div class="text-center" hidden>
                            <a href="#" style="font-size:16px;">¿Olvidaste tu contraseña?</a>
                        </div>
                    </div>
                    <div class="row" style="margin-top:25px;">
                        <div class="text-center">
                            @footer
                        </div>
                    </div>
                </div>
            </main>
        </div>
    
    </div>
    <div class="d-none d-sm-block login" style="background: url('@fondoWeb') no-repeat center center fixed;background-size:cover;">
        <main class="main" id="top">
            <div class="container-fluid">
                <div class="row min-vh-100 flex-center g-0">
                    <div class="col-7 text-center d-none d-sm-block" style="padding:6%;">
                        <div class="card overflow-hidden z-index-1">
                            <div class="card-body p-0">
                                <div class="row g-0 h-100">
                                    <div class="col-md-12">
                                        <div id="demo" class="carousel slide" data-bs-ride="carousel">
                                            <!-- Aquí irían las imágenes o videos del carrusel -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-5 text-center d-none d-sm-block" style="padding-right:5%;">
                        <div class="card overflow-hidden z-index-1" style="border-radius:16px;max-width:800px;">
                            <div class="card-body p-0">
                                <div class="row g-0 h-100">
                                    <div class="p-4 p-md-5 flex-grow-1">
                                        <div class="row flex-between-center">
                                            <div class="text-center" style="margin-top:50px;">
                                                <img src="~/images/logo.png" style="max-height:183px;max-width:244px" />
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:40px;">
                                            <div class="col-lg-12" style="color:#217FE9;font-size:20px;font-weight:700;text-align:left;font-family:'Roboto'">
                                                ¡Bienvenido(a) a ADEX Intranet - Docente!
                                            </div>
                                        </div>
                                        <div class="row" style="margin-top:10px;">
                                            <div class="col-lg-12 titulo2" style="font:Roboto">
                                                Escribe tus datos para ingresar
                                            </div>
                                        </div>
                                        <div class="form-group" style="margin-top:10px;">
                                            <div class="input-icon">
                                                <span class="icon-user">
                                                    <img src="~/img/user2.png" height="24" width="24" />
                                                </span>
                                                <input class="form-control" style="height:48px !important;padding: 6px 40px !important;" id="Usuario" type="text" placeholder="Código de docente" required>
                                            </div>
                                        </div>
                                        <div class="form-group" style="margin-top:10px;">
                                            <div class="input-icon">
                                                <span class="icon-user">
                                                    <img src="~/img/padlock.png" height="24" width="24" />
                                                </span>
                                                <input class="form-control" style="height:48px !important;padding: 6px 40px !important;" id="card-password" type="password" placeholder="Contraseña" required>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12 text-center text-danger" style="margin:10px;" id="divMensajesesion"></div>
                                        </div>
                                        <div class="mb-3">
                                            <input class="btn-login d-block w-100 mt-3" id="btnloginw" type="submit" name="submit" onclick="ValidarCredenciales('@requestLogin')" value="Ingresar" />
                                        </div>
                                        <div class="row">
                                            <div class="text-center" hidden>
                                                <a href="#" style="color:#217FE9;font-size:16px;">¿Olvidaste tu contraseña?</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top:15px;">
                            <div class="col-lg-12 col-xs-12" style="color:#79B8FF; font-family:Roboto;max-width:800px;">
                                @footer
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
    <input type="hidden" id="hdfip" />
    
    
    
    <div id="DivAjax" class="modal-backdrop-light" style="display:none;">
        <div id="DivAjaxInside" style="display:none;">
            <img src="~/images/loader.gif" width="160" />
        </div>
    </div>
    <script type="text/javascript">
        $('.modal-backdrop').remove();
        $(document).keypress(function (event) {
            var keycode = (event.keyCode ? event.keyCode : event.which);
            if (keycode == '13') { //'13' --> enter
                $("#btnloginw").trigger('click');;
            }
        });

        function showAjaxLoading() {
            $('#DivAjax').show();
            $('#DivAjaxInside').show();
        }

        function stopAjaxLoading() {
            $('#DivAjax').hide();
            $('#DivAjaxInside').hide();
        }
    </script>
    <script type="text/javascript">
        $.getJSON('http://ip.jsontest.com/', function (data) {
            $("#hdfip").val(JSON.stringify(data, null, 2));
        });
    </script>
</body>
</html>
