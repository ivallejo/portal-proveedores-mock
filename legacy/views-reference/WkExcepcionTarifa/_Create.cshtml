<form autocomplete="off" id="frmAccion">
	<div class="offcanvas offcanvas-end offcanvas-custom" id="nuevoExcepcionTarifaModal" aria-labelledby="nuevoExcepcionTarifaModalLabel" data-bs-backdrop="true">
		<div class="offcanvas-header">
			<h5 class="offcanvas-title fw-bold" id="tituloExcepcionTarifaModal">Nueva Tarifa de Docente</h5>
			<button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
		</div>
		<div class="offcanvas-body d-flex flex-column">
			<div class="row">
				<div class="col-md-12">
					<div class="form-floating">
						<select class="form-select" id="organizacionModal" disabled></select>
						<label for="organizacionModal">Organización</label>
					</div>
				</div>
			</div>
			<div class="row mt-4">
				<div class="col-md-12">
					<div class="form-floating">
						<select class="form-select" id="periodoAcademicoModal" disabled></select>
						<label for="periodoAcademicoModal">Periodo</label>
					</div>
				</div>
			</div>
			<div class="row mt-3">
				<div class="col-md-12">
					<div class="input-group input-group-typeahead-icon">
						<span class="input-group-text bg-white blocked"><i class="fas fa-search"></i></span>
						<input type="text" class="form-control" id="docenteModal" placeholder="Código o nombre de docente" disabled>
					</div>
				</div>
			</div>
			<div class="row mt-3">
				<div class="col-md-12">
					<div class="input-group input-group-typeahead-icon">
						<span class="input-group-text bg-white blocked"><i class="fas fa-search"></i></span>
						<input type="text" class="form-control" id="cursoModal" placeholder="Código o nombre de curso" disabled>
					</div>
				</div>
			</div>
			<div class="row mt-4">
				<div class="col-md-12">
					<div class="form-floating">
						<input type="text" class="form-control" required id="tarifaModal" data-val="true" placeholder="">
						<label for="tarifaModal">Tarifa</label>
					</div>
				</div>
			</div>
			<div class="row mt-auto">
				<div class="col-md-6 mt-2">
					<button class="btn btn-primary form-control" id="btnGuardarModal">Guardar</button>
				</div>
				<div class="col-md-6 mt-2">
					<button type="button" class="btn btn-outline-primary form-control" data-bs-dismiss="offcanvas">Cancelar</button>
				</div>
			</div>
		</div>
	</div>
</form>
<script src="~/js/workflow/excepcion-tarifa/excepcion-tarifa-create.js" asp-append-version="true"></script>